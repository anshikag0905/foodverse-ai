# ========================================================
# FoodVerse AI – Environment Configuration Template
# ========================================================

# General Configuration
APP_NAME="FoodVerse AI"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="foodverse-super-secret-development-key-change-in-production"
API_V1_STR="/api/v1"

# Server Network Settings
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Demo Mode & Mock AI Configuration
# When DEMO_MODE=true, the platform uses deterministic mock AI providers
# requiring zero external API keys.
DEMO_MODE=true
AI_PROVIDER="mock"  # Options: "mock", "gemini", "openai"

# Real AI Provider Credentials (Optional when DEMO_MODE=true)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Database Configuration
DATABASE_URL="sqlite:///./backend/data/foodverse.db"
FOOD_DATABASE_PATH="./backend/data/food_database.sqlite"

# File Storage Configuration
STORAGE_TYPE="local" # Options: "local", "s3"
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=50
KITCHEN_VIDEO_RETENTION_HOURS=24

# Security / Auth
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SINGLE_USER_MODE=true
DEFAULT_USER_EMAIL="demo@foodverse.ai"
